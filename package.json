{
  "name": "game-rank-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/prune-production-local-only.mjs && node scripts/verify-production-local-only-pruned.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --experimental-strip-types src/**/*.test.ts",
    "check:worker": "wrangler deploy -c wrangler.worker.toml --dry-run",
    "deploy:worker": "wrangler deploy -c wrangler.worker.toml"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "next": "16.2.6",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260522.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "typescript": "^5",
    "wrangler": "^4.94.0"
  }
}
